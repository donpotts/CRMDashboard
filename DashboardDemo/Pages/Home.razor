@page "/"

<PageTitle>Dashboard Demo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">My Dashboard</MudText>

<Dashboard StorageKey="demo-dashboard"
           InitialLayoutFactory="GetLayout"
           Options="@_options"
           AddCardText="Add Widget"
           ResetLayoutText="Reset All" />

@code {
    private DashboardOptions _options = new()
    {
        ShowAddButton = false,
        ShowResetButton = false,
        AllowDelete = true,
        AllowMove = true,
        AllowResize = true,
        AutoRenderCharts = true,
        Grid = new GridOptions
        {
            CellHeight = 70,
            Margin = 10,
            Column = 12
        }
    };

    private List<DashboardCard> GetLayout() => new()
    {
        // Line Chart
        new DashboardCard
        {
            Id = "sales",
            Title = "Monthly Sales",
            X = 0, Y = 0, W = 6, H = 4,
            ChartConfig = new ChartConfig
            {
                Type = "line",
                Labels = new List<string> { "Jan", "Feb", "Mar", "Apr", "May", "Jun" },
                Datasets = new List<ChartDataset>
                {
                    new ChartDataset
                    {
                        Label = "Sales ($k)",
                        Data = new List<double> { 12, 19, 15, 25, 22, 30 },
                        BorderColor = "#1976d2",
                        BackgroundColor = "rgba(25, 118, 210, 0.1)",
                        Tension = 0.4,
                        Fill = true
                    }
                }
            }
        },
        // Doughnut Chart
        new DashboardCard
        {
            Id = "categories",
            Title = "Sales by Category",
            X = 6, Y = 0, W = 6, H = 4,
            ChartConfig = new ChartConfig
            {
                Type = "doughnut",
                Labels = new List<string> { "Electronics", "Clothing", "Food", "Books" },
                Datasets = new List<ChartDataset>
                {
                    new ChartDataset
                    {
                        Label = "Categories",
                        Data = new List<double> { 300, 200, 150, 100 },
                        BackgroundColors = new List<string> { "#1976d2", "#388e3c", "#f57c00", "#7b1fa2" }
                    }
                }
            }
        },
        // Bar Chart
        new DashboardCard
        {
            Id = "revenue",
            Title = "Quarterly Revenue",
            X = 0, Y = 4, W = 6, H = 4,
            ChartConfig = new ChartConfig
            {
                Type = "bar",
                Labels = new List<string> { "Q1", "Q2", "Q3", "Q4" },
                Datasets = new List<ChartDataset>
                {
                    new ChartDataset
                    {
                        Label = "Revenue ($k)",
                        Data = new List<double> { 65, 78, 90, 85 },
                        BackgroundColor = "rgba(56, 142, 60, 0.8)"
                    }
                }
            }
        },
        // Radar Chart
        new DashboardCard
        {
            Id = "performance",
            Title = "Team Performance",
            X = 6, Y = 4, W = 6, H = 4,
            ChartConfig = new ChartConfig
            {
                Type = "radar",
                Labels = new List<string> { "Speed", "Quality", "Communication", "Teamwork", "Innovation" },
                Datasets = new List<ChartDataset>
                {
                    new ChartDataset
                    {
                        Label = "Team A",
                        Data = new List<double> { 85, 90, 78, 88, 92 },
                        BackgroundColor = "rgba(25, 118, 210, 0.2)",
                        BorderColor = "#1976d2"
                    }
                }
            }
        }
    };
}

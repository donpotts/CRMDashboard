@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject IThemeService ThemeService
@inject IDashboardStorageService StorageService
@inject ChartService ChartService
@implements IAsyncDisposable

<div class="dashboard-wrapper">
    @if (_effectiveOptions.ShowAddButton || _effectiveOptions.ShowResetButton)
    {
        <div class="controls">
            @if (_effectiveOptions.ShowAddButton)
            {
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="MudBlazor.Color.Primary" OnClick="HandleAddCard">@AddCardText</MudButton>
            }
            @if (_effectiveOptions.ShowResetButton)
            {
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DeleteForever" Color="MudBlazor.Color.Primary" OnClick="HandleResetLayout">@ResetLayoutText</MudButton>
            }
        </div>
    }

    <div class="dashboard-container">
        <div class="grid-stack"></div>
    </div>

    <div style="display: none;" id="card-content-placeholders">
        @foreach (var card in _currentLayout)
        {
            <div id="content-for-@card.Id">
                <div class="card-header">
                    <span class="card-title">@card.Title</span>
                    <div class="card-controls">
                        @if (_effectiveOptions.AllowMove && !card.Locked)
                        {
                            <span class="move-handle"><i class="fas fa-arrows-alt"></i></span>
                        }
                        @if (_effectiveOptions.AllowDelete && !card.Locked)
                        {
                            <span class="delete-handle" data-card-id="@card.Id">
                                <i class="fas fa-trash-alt"></i>
                            </span>
                        }
                    </div>
                </div>
                <div class="card-body @card.CssClass">
                    @GetCardContent(card)
                </div>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Storage key for persisting layout to localStorage.
    /// </summary>
    [Parameter, EditorRequired]
    public string StorageKey { get; set; } = default!;

    /// <summary>
    /// Factory function that returns the initial card layout.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<List<DashboardCard>> InitialLayoutFactory { get; set; } = default!;

    /// <summary>
    /// Optional custom renderer for card content. If not provided, charts are rendered automatically.
    /// </summary>
    [Parameter]
    public RenderFragment<DashboardCard>? CardRenderer { get; set; }

    /// <summary>
    /// Event fired when layout changes (card added, deleted, moved, resized).
    /// </summary>
    [Parameter]
    public EventCallback OnLayoutChanged { get; set; }

    /// <summary>
    /// Configuration options for the dashboard. Overrides global options if provided.
    /// </summary>
    [Parameter]
    public DashboardOptions? Options { get; set; }

    /// <summary>
    /// Event fired when a card is added.
    /// </summary>
    [Parameter]
    public EventCallback<DashboardCard> OnCardAdded { get; set; }

    /// <summary>
    /// Event fired when a card is deleted.
    /// </summary>
    [Parameter]
    public EventCallback<DashboardCard> OnCardDeleted { get; set; }

    /// <summary>
    /// Event fired when layout is saved.
    /// </summary>
    [Parameter]
    public EventCallback<List<DashboardCard>> OnLayoutSaved { get; set; }

    /// <summary>
    /// Text for the Add Card button.
    /// </summary>
    [Parameter]
    public string AddCardText { get; set; } = "Add Card";

    /// <summary>
    /// Text for the Reset Layout button.
    /// </summary>
    [Parameter]
    public string ResetLayoutText { get; set; } = "Reset Layout";

    /// <summary>
    /// Optional factory for creating new cards. If not provided, default cards are created.
    /// </summary>
    [Parameter]
    public Func<DashboardCard>? NewCardFactory { get; set; }

    // Injected global options (optional)
    [Inject]
    private DashboardOptions? GlobalOptions { get; set; }

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<Dashboard>? _dotNetHelper;
    private List<DashboardCard> _currentLayout = new();
    private bool _isGridJsInitialized = false;
    private int _cardCounter = 0;

    private DashboardOptions _effectiveOptions => Options ?? GlobalOptions ?? new DashboardOptions();

    protected override void OnInitialized()
    {
        _dotNetHelper = DotNetObjectReference.Create(this);
        ThemeService.OnChange += HandleThemeChange;
    }

    private async void HandleThemeChange()
    {
        if (_effectiveOptions.AutoRenderCharts)
        {
            await RenderChartsAsync();
        }
        await OnLayoutChanged.InvokeAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isGridJsInitialized)
        {
            _isGridJsInitialized = true;
            await LoadLayoutFromStorage();
        }
    }

    private RenderFragment GetCardContent(DashboardCard card)
    {
        // If consumer provides custom renderer, use it
        if (CardRenderer != null)
        {
            return CardRenderer(card);
        }

        // Auto-render charts for cards with ChartConfig
        if (card.ChartConfig != null && _effectiveOptions.AutoRenderCharts)
        {
            return builder =>
            {
                builder.OpenComponent<ChartCard>(0);
                builder.AddAttribute(1, "CardId", card.Id);
                builder.AddAttribute(2, "Config", card.ChartConfig);
                builder.CloseComponent();
            };
        }

        // Fallback to default content
        return builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "default-card");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "default-card-content");
            builder.OpenElement(4, "h4");
            builder.AddContent(5, card.Title);
            builder.CloseElement();
            builder.OpenElement(6, "p");
            builder.AddContent(7, "Configure this card by setting CardType or ChartConfig.");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        };
    }

    private async Task LoadLayoutFromStorage()
    {
        if (_effectiveOptions.PersistLayout)
        {
            var savedItems = await StorageService.LoadLayoutAsync(StorageKey);
            if (savedItems.Any())
            {
                var initialItems = InitialLayoutFactory.Invoke().ToDictionary(c => c.Id);
                foreach (var item in savedItems)
                {
                    if (initialItems.TryGetValue(item.Id, out var initial))
                    {
                        item.Title = initial.Title;
                        item.CardType = initial.CardType;
                        item.ChartConfig = initial.ChartConfig;
                    }
                }
                _currentLayout = savedItems;
            }
            else
            {
                _currentLayout = InitialLayoutFactory.Invoke();
            }
        }
        else
        {
            _currentLayout = InitialLayoutFactory.Invoke();
        }

        _cardCounter = _currentLayout.Any() ? _currentLayout.Max(c => int.TryParse(c.Id.Split('-').Last(), out var num) ? num : 0) : 0;
        await InvokeAsync(StateHasChanged);

        if (_jsModule == null)
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/DP.BlazorDashboard/js/dashboard-manager.js");
        }

        var gridOptions = _effectiveOptions.Grid;
        await _jsModule.InvokeVoidAsync("init", ".dashboard-wrapper", _dotNetHelper, _currentLayout, gridOptions);
        await _jsModule.InvokeVoidAsync("setupDeleteEventDelegation", _dotNetHelper);

        await OnLayoutChanged.InvokeAsync();

        // Auto-render charts after grid initialization
        if (_effectiveOptions.AutoRenderCharts)
        {
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        var chartsToRender = _currentLayout.Where(c => c.ChartConfig != null).ToList();
        if (chartsToRender.Any())
        {
            await ChartService.RenderAllChartsAsync(chartsToRender, _effectiveOptions.ChartRenderDelayMs);
        }
    }

    private async Task HandleAddCard()
    {
        var (nextX, nextY) = CalculateNextCardPosition();
        var gridOptions = _effectiveOptions.Grid;

        DashboardCard newCard;
        if (NewCardFactory != null)
        {
            newCard = NewCardFactory();
            newCard.Id = $"new-card-{++_cardCounter}";
            if (newCard.X == 0 && newCard.Y == 0)
            {
                newCard.X = nextX;
                newCard.Y = nextY;
            }
        }
        else
        {
            newCard = new DashboardCard
            {
                Id = $"new-card-{++_cardCounter}",
                Title = "New Card",
                CardType = "default",
                X = nextX,
                Y = nextY,
                W = gridOptions.DefaultCardWidth,
                H = gridOptions.DefaultCardHeight
            };
        }

        _currentLayout.Add(newCard);

        if (_effectiveOptions.PersistLayout)
        {
            await StorageService.SaveLayoutAsync(StorageKey, _currentLayout);
            await OnLayoutSaved.InvokeAsync(_currentLayout);
        }

        await InvokeAsync(StateHasChanged);

        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("addCard", newCard);
        }

        await OnCardAdded.InvokeAsync(newCard);
        await OnLayoutChanged.InvokeAsync();
    }

    private (int x, int y) CalculateNextCardPosition()
    {
        if (_currentLayout.Count == 0) return (0, 0);
        var gridOptions = _effectiveOptions.Grid;
        int gridWidth = gridOptions.Column;
        int cardWidth = gridOptions.DefaultCardWidth;
        int maxY = _currentLayout.Max(c => c.Y + c.H);
        var bottomRowCards = _currentLayout.Where(c => c.Y + c.H == maxY).ToList();
        if (bottomRowCards.Any())
        {
            var rightmostCard = bottomRowCards.OrderByDescending(c => c.X + c.W).First();
            int nextX = rightmostCard.X + rightmostCard.W;
            if (nextX + cardWidth <= gridWidth) { return (nextX, rightmostCard.Y); }
        }
        return (0, maxY);
    }

    [JSInvokable]
    public async Task HandleDeleteCard(string cardId)
    {
        if (!_effectiveOptions.AllowDelete) return;

        var cardToDelete = _currentLayout.FirstOrDefault(c => c.Id == cardId);
        if (cardToDelete == null || cardToDelete.Locked) return;

        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.CardTitle, cardToDelete.Title }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _currentLayout.Remove(cardToDelete);

            if (_effectiveOptions.PersistLayout)
            {
                await StorageService.SaveLayoutAsync(StorageKey, _currentLayout);
                await OnLayoutSaved.InvokeAsync(_currentLayout);
            }

            await RerenderGrid();
            await OnCardDeleted.InvokeAsync(cardToDelete);
            await OnLayoutChanged.InvokeAsync();
        }
    }

    private async Task HandleResetLayout()
    {
        _currentLayout = InitialLayoutFactory.Invoke();
        _cardCounter = _currentLayout.Any() ? _currentLayout.Max(c => int.TryParse(c.Id.Split('-').Last(), out var num) ? num : 0) : 0;

        if (_effectiveOptions.PersistLayout)
        {
            await StorageService.ClearLayoutAsync(StorageKey);
        }

        await RerenderGrid();
        await OnLayoutChanged.InvokeAsync();

        // Re-render charts after reset
        if (_effectiveOptions.AutoRenderCharts)
        {
            await RenderChartsAsync();
        }
    }

    private async Task RerenderGrid()
    {
        await InvokeAsync(StateHasChanged);
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("loadData", _currentLayout);
        }
    }

    [JSInvokable]
    public async Task OnLayoutUpdatedFromJS(List<DashboardCard> updatedLayout)
    {
        var dict = _currentLayout.ToDictionary(c => c.Id);
        foreach (var item in updatedLayout)
        {
            if (dict.TryGetValue(item.Id, out var cardToUpdate))
            {
                cardToUpdate.X = item.X;
                cardToUpdate.Y = item.Y;
                cardToUpdate.W = item.W;
                cardToUpdate.H = item.H;
            }
        }

        if (_effectiveOptions.PersistLayout)
        {
            await StorageService.SaveLayoutAsync(StorageKey, _currentLayout);
            await OnLayoutSaved.InvokeAsync(_currentLayout);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnChange -= HandleThemeChange;

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroy");
            }
            catch (JSDisconnectedException)
            {
            }
            finally
            {
                await _jsModule.DisposeAsync();
            }
        }
        _dotNetHelper?.Dispose();
    }
}

@page "/"
@page "/crmdashboard"
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient HttpClient
@using DP.BlazorDashboard.Models
@using DP.BlazorDashboard.Components

<PageTitle>CRM Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Welcome to the CRM Dashboard</MudText>

@* Dashboard component with full parameter configuration *@
<Dashboard StorageKey="crm-dashboard-v2"
           InitialLayoutFactory="GetInitialLayout"
           CardRenderer="RenderNonChartCards"
           Options="@_dashboardOptions"
           AddCardText="Add Widget"
           ResetLayoutText="Reset Dashboard"
           NewCardFactory="CreateNewCard"
           OnLayoutChanged="HandleLayoutChanged"
           OnCardAdded="HandleCardAdded"
           OnCardDeleted="HandleCardDeleted"
           OnLayoutSaved="HandleLayoutSaved" />

@code {
    // Dashboard options can override global settings from Program.cs
    private DashboardOptions _dashboardOptions = new()
    {
        ShowAddButton = true,
        ShowResetButton = true,
        AllowDelete = true,
        AllowMove = true,
        AllowResize = true,
        PersistLayout = true,
        AutoRenderCharts = true,
        ChartRenderDelayMs = 150,
        Grid = new GridOptions
        {
            CellHeight = 70,
            Margin = 10,
            Column = 12,
            Float = true,
            Animate = true,
            DefaultCardWidth = 4,
            DefaultCardHeight = 4
        }
    };

    // Factory for creating new cards when "Add Widget" is clicked
    private DashboardCard CreateNewCard() => new()
    {
        Id = $"card-{Guid.NewGuid():N}",
        Title = "New Widget",
        CardType = "custom",
        X = 0,
        Y = 0,
        W = _dashboardOptions.Grid.DefaultCardWidth,
        H = _dashboardOptions.Grid.DefaultCardHeight,
        MinW = 2,
        MinH = 2,
        Data = new { CreatedAt = DateTime.Now }
    };

    // Event handlers for dashboard interactions
    private async Task HandleLayoutChanged()
    {
        // Layout changed - could trigger analytics or sync
        await Task.CompletedTask;
    }

    private async Task HandleCardAdded(DashboardCard card)
    {
        Snackbar.Add($"Widget '{card.Title}' added", Severity.Success);
        await Task.CompletedTask;
    }

    private async Task HandleCardDeleted(DashboardCard card)
    {
        Snackbar.Add($"Widget '{card.Title}' removed", Severity.Info);
        await Task.CompletedTask;
    }

    private async Task HandleLayoutSaved(List<DashboardCard> layout)
    {
        // Layout saved to localStorage - could sync to server here
        await Task.CompletedTask;
    }

    private List<DashboardCard> GetInitialLayout() => new()
